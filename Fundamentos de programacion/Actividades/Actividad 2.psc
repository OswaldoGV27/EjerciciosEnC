Algoritmo Actividad2
	Definir a Como Entero
	a=0
	// Utilizando la estructura Iterativa Mientras
	
	Escribir "Utilizando la estructura Iterativa Mientras";
	Mientras(a<=5) Hacer
		Escribir a;
		a=a+1
	FinMientras
	
	//Utilizando Estructura Iterativa Repetir
	
	Escribir "Utilizando la estructura Iterativa Repetir";
	a=0
	Repetir 
		Escribir a;
		a=a+1
	Hasta Que (a>5)
	
FinAlgoritmo
